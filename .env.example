# 晴川（QingChuan）部署环境配置模板
# 复制为根目录 .env（.env 已被 .gitignore 排除，勿提交）后按实际环境填写。
#
# 阿里云单机部署：
#   cp .env.example .env && vim .env
#   docker compose up -d --build
#
# 必填项（compose 使用 ${VAR:?} 强校验，缺失启动即报错）：MYSQL_ROOT_PASSWORD / MYSQL_USER / MYSQL_PASSWORD / REDIS_PASSWORD / MINIO_ROOT_PASSWORD

# ─── 部署共用凭据（docker-compose 读取；生产请使用强密码）───
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=qingchuan
MYSQL_USER=qingchuan
MYSQL_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
# MinIO（Milvus 对象存储组件）root 凭据；生产必须修改默认值
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
# 宿主端口（可选覆盖；默认 mysql 13306 / redis 16379）
# MYSQL_HOST_PORT=13306
# REDIS_HOST_PORT=16379

# ─── Agent 服务 LLM（前缀 QINGCHUAN_AGENT_AI_LLM_，与 RAG 的 MIMO_* 相互独立）───
QINGCHUAN_AGENT_AI_LLM_API_KEY=sk-your-key
QINGCHUAN_AGENT_AI_LLM_BASE_URL=https://api.xiaomimimo.com/v1
QINGCHUAN_AGENT_AI_LLM_MODEL=mimo-v2.6-pro
# Agent CORS 允许来源（生产禁 *；pydantic list 类型，须用 JSON 数组格式）
# QINGCHUAN_AGENT_CORS_ORIGINS=["http://localhost:5173","https://admin.example.com"]

# ─── RAG 服务 LLM（Provider：小米 Mimo；仅 rag-service 读取）───
MIMO_API_KEY=sk-your-key
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_MODEL_NAME=mimo-v2.6-pro

# ─── RAG 服务向量存储 ───
# 三种形态（docker-compose 部署时 rag-service 内部固定连 http://milvus:19530，不走本变量）：
#   1) 本地调试连本机 Milvus 服务（D:\04Docker\Milvus standalone）：http://localhost:19530
#   2) milvus-lite 本地文件模式（无需外部服务）：./data/milvus.db
#   3) 外部/自建远程 Milvus：http://<host>:19530（可加鉴权）
# 注意：变量名不得用 MILVUS_URI（pymilvus 自身保留该环境变量，会解析报错）
VECTOR_STORE_TYPE=milvus
VECTOR_STORE_MILVUS_URI=http://localhost:19530
VECTOR_STORE_COLLECTION_NAME=documents
VECTOR_STORE_DISTANCE=cosine
VECTOR_STORE_DIMENSION=1024

# ─── RAG 人社数据源与周期调度（按需开启）───
# SYNC_ENABLED=false
# SYNC_CRON=0 3 * * *
# HRSS_API_URL=https://hrss.example.com/api
# HRSS_API_TOKEN=your-token
