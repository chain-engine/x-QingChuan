# x-QingChuan agent-service 环境配置模板
# 复制为仓库根 .env（与服务级配置合并）或按需注入环境变量
# 所有环境变量使用 QINGCHUAN_AGENT_ 前缀（与 core/config.py 分段对齐）

# ========================================
# Redis 配置（checkpoint 与事件总线共用同一实例）
# - checkpoint：agent.checkpoint=redis 时，LangGraph RedisSaver 断点落 Redis
# - 事件总线：enabled=true 时，EventBus 切换 Redis Pub/Sub（跨进程广播）
# 生产环境（APP_ENV=production）必须启用 Redis
# ========================================
QINGCHUAN_AGENT_REDIS_ENABLED=false
QINGCHUAN_AGENT_REDIS_HOST=localhost
QINGCHUAN_AGENT_REDIS_PORT=6379
QINGCHUAN_AGENT_REDIS_DB=0
QINGCHUAN_AGENT_REDIS_USERNAME=
QINGCHUAN_AGENT_REDIS_PASSWORD=
QINGCHUAN_AGENT_REDIS_SSL=false
# 可选：完整连接 URL 优先于 host/port 组装（redis://[user:pass@]host:port/db）
# QINGCHUAN_AGENT_REDIS_URL=
# QINGCHUAN_AGENT_REDIS_SOCKET_TIMEOUT=5.0

# ========================================
# Agent 编排（checkpoint 模式：memory / redis）
# ========================================
# QINGCHUAN_AGENT_AGENT_CHECKPOINT=memory
