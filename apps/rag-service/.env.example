# x-QingChuan 环境配置模板
# 将此文件复制为 .env 并填入你的配置值

# ========================================
# 服务端配置
# ========================================
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
SERVER_WORKERS=4
SERVER_ENVIRONMENT=development
LOG_LEVEL=INFO

# ========================================
# 日志配置
# ========================================
LOG_FILE_PATH=./logs/x-QingChuan-{time:YYYYMMDDHHmmss}.log
LOG_ROTATION=1 day
LOG_RETENTION=7 days

# ========================================
# 业务数据库（审计日志 / 同步任务 / 文档元数据，MySQL；本地可 SQLite）
# ========================================
DATABASE_URL=mysql+pymysql://yeyushilai:123456@localhost:3306/qingchuan?charset=utf8mb4

# ========================================
# 文件存储（文档内容对象存储；元数据入库后内容走此层）
# provider: local | s3
#   local：本地文件系统（开发 / 单机生产默认，相对路径锚定 apps/rag-service/data）
#   s3：S3 兼容对象存储（MinIO / 阿里云 OSS / 腾讯 COS / 七牛 Kodo，生产推荐）
# ========================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=./data/documents
STORAGE_LOCAL_PUBLIC_PREFIX=/files
# S3 兼容对象存储（STORAGE_PROVIDER=s3 时生效；缺凭据自动回退 local）
# STORAGE_S3_ENDPOINT_URL=http://minio:9000
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_BUCKET=qingchuan
# STORAGE_S3_REGION=
# STORAGE_S3_PREFIX=documents
# STORAGE_S3_PUBLIC_URL=
# STORAGE_S3_USE_SSL=false

# ========================================
# 人社数据同步（触发接口 + 周期调度）
# 数据源接口层在 qingchuan_rag/infras/hrss.py（依赖 infras/http.py）
# ========================================
SYNC_ENABLED=false
SYNC_CRON=0 3 * * *
SYNC_BATCH_SIZE=100
SYNC_INCREMENTAL=true
# 人社数据源（生产必填；接入细节见 qingchuan_rag/infras/hrss.py）
HRSS_API_URL=
HRSS_API_TOKEN=
HRSS_API_TIMEOUT=30.0
# mock 模式：无真实 API 时返回本地示例数据，便于端到端调试同步链路
HRSS_MOCK=true
HRSS_MOCK_COUNT=5

# ========================================
# 向量嵌入配置
# ========================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=1000
EMBEDDING_NORMALIZE=true

# ========================================
# 向量存储配置
# ========================================
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PERSIST_DIR=./data/chroma
VECTOR_STORE_COLLECTION_NAME=documents
VECTOR_STORE_DISTANCE=cosine

# ========================================
# 文本切分配置
# ========================================
TEXT_SPLITTER_PROVIDER=langchain  # langchain | llamaindex
TEXT_SPLITTER_STRATEGY=recursive  # recursive | character | token | semantic（langchain）/ sentence | token | semantic | markdown（llamaindex）
TEXT_SPLITTER_CHUNK_SIZE=512
TEXT_SPLITTER_CHUNK_OVERLAP=50
# TEXT_SPLITTER_SEPARATORS 为多字符分隔符列表，env 无法可靠表达，请通过 config.yaml 的 text_splitter.separators 配置

# ========================================
# 检索配置
# ========================================
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.7
RETRIEVAL_USE_MMR=false
RETRIEVAL_MMR_LAMBDA=0.5

# ========================================
# 生成配置
# ========================================
GENERATION_PROVIDER=mimo
GENERATION_MODEL=mimo-v2.6-pro
GENERATION_TEMPERATURE=0.7
GENERATION_MAX_TOKENS=2000
GENERATION_TIMEOUT=30

# ========================================
# LLM 调用层通用默认（所有 Provider 的兜底参数）
# ========================================
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ========================================
# 大模型供应商 API 配置
# ========================================
# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 豆包 API (字节跳动)
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=doubao-pro-32k

# 阿里云百炼 API (通义千问)
ALIYUN_API_KEY=your-aliyun-api-key-here
ALIYUN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_NAME=qwen-plus

# 小米 Mimo API
MIMO_API_KEY=your-mimo-api-key-here
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_MODEL_NAME=mimo-v2.6-pro

# ========================================
# 限流配置
# ========================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ========================================
# 跨域配置 (CORS)
# ========================================
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
