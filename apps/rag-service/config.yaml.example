# x-QingChuan 配置文件模板
# 将此文件复制为 config.yaml 并填入你的配置值

# ====================================
# 服务配置
# ====================================
server:
  host: 0.0.0.0
  port: 8010
  debug: true
  workers: 4
  environment: development

# ====================================
# 日志配置
# ====================================
logging:
  level: INFO
  file_path: ./logs/x-QingChuan-{time:YYYYMMDDHHmmss}.log
  rotation: 1 day
  retention: 7 days

# ====================================
# 业务数据库配置（审计日志 / 同步任务 / 文档元数据，MySQL；本地可 SQLite）
# ====================================
database:
  # 默认 MySQL（生产）；本地开发可切回 sqlite:///./data/qingchuan.db
  # 注意：数据库需提前创建（如 CREATE DATABASE qingchuan CHARACTER SET utf8mb4）
  db_url: "mysql+pymysql://yeyushilai:123456@127.0.0.1:3306/qingchuan?charset=utf8mb4"

# ====================================
# 文件存储配置（文档内容对象存储；元数据入库后内容走此层）
# provider: local | s3
#   local：本地文件系统（开发 / 单机生产默认，相对路径锚定 apps/rag-service/data）
#   s3：S3 兼容对象存储（MinIO / 阿里云 OSS / 腾讯 COS / 七牛 Kodo，生产推荐）
# ====================================
storage:
  provider: local            # local | s3
  # local 后端
  base_dir: ./data/documents # 本地内容根目录（相对路径自动锚定服务根）
  public_prefix: /files      # 本地静态访问前缀（FastAPI StaticFiles 挂载点）
  # s3 后端（provider: s3 时生效；缺凭据自动回退 local）
  s3_endpoint_url: ""        # S3 兼容服务地址，如 http://minio:9000
  s3_access_key: ""
  s3_secret_key: ""
  s3_bucket: ""              # 存储空间名称
  s3_region: ""              # 可选
  s3_prefix: documents       # 对象键前缀
  s3_public_url: ""          # 可选：公开访问域名（含协议头）
  s3_use_ssl: true

# ====================================
# 人社数据同步配置（触发接口 + 周期调度）
# ====================================
sync:
  enabled: false              # true=启动内置 APScheduler 周期调度
  cron: "0 3 * * *"           # 周期表达式（默认每天 03:00）
  batch_size: 100             # 每批拉取条数
  incremental: true           # 默认增量同步
  # 人社数据源（生产必填；接口层在 qingchuan_rag/infras/hrss.py）
  data_source_url: ""         # HRSS_API_URL
  data_source_token: ""       # HRSS_API_TOKEN（Bearer 认证）
  data_source_timeout: 30.0   # HRSS_API_TIMEOUT 请求超时（秒）
  data_source_mock: true      # HRSS_MOCK：true=本地示例数据调试（默认）；false=请求真实人社 API
  data_source_mock_count: 5   # HRSS_MOCK_COUNT：mock 示例数据条数

# ====================================
# 向量嵌入配置
# ====================================
embedding:
  model: BAAI/bge-m3
  device: cpu
  batch_size: 32
  cache_size: 1000
  normalize: true

# ====================================
# 向量存储配置
# type: milvus | chroma
#   milvus：默认（生产推荐）。本地用 milvus-lite 文件模式（uri 指向本地文件），生产改远程 Milvus
#           Standalone 地址（如 http://milvus-host:19530）
#   chroma：开发备选，持久化于 persist_directory
# ====================================
vector_store:
  type: milvus
  # milvus 后端
  milvus_uri: ./data/milvus.db   # 本地 milvus-lite 文件；生产为远程地址 http://host:19530
  # 远程 Milvus 鉴权（本地 milvus-lite 无需配置，留空即可）
  #   token：Milvus RBAC / JWT token（Zilliz Cloud 等托管服务使用）
  #   username / password：Milvus 用户名密码认证
  milvus_token: ""
  milvus_username: ""
  milvus_password: ""
  collection_name: documents
  distance: cosine
  dimension: 1024                # 与 embedding 模型（bge-m3）输出维度一致
  # chroma 后端（type: chroma 时生效）
  persist_directory: ./data/chroma

# ====================================
# 文本切分配置
# ====================================
text_splitter:
  provider: langchain  # langchain | llamaindex
  strategy: recursive  # recursive | character | token | semantic（langchain）/ sentence | token | semantic | markdown（llamaindex）
  chunk_size: 512
  chunk_overlap: 50
  separators:
    - "\n\n"
    - "\n"
    - "。"
    - "！"
    - "？"
    - " "
    - ""

# ====================================
# 检索配置
# ====================================
retrieval:
  top_k: 5
  similarity_threshold: 0.7
  use_mmr: false
  mmr_lambda: 0.5

# ====================================
# 生成配置
# ====================================
generation:
  provider: mimo
  model: mimo-v2.6-pro
  temperature: 0.7
  max_tokens: 2000
  timeout: 30

# ====================================
# LLM 调用层通用默认（所有 Provider 的兜底参数）
# ====================================
llm:
  max_tokens: 2000
  timeout: 30

# ====================================
# LLM 提供商配置
# ====================================
llm_providers:
  # DeepSeek
  deepseek_api_key: your-deepseek-api-key
  deepseek_api_base: https://api.deepseek.com/v1
  deepseek_model_name: deepseek-chat
  # 豆包 (字节跳动)
  doubao_api_key: your-doubao-api-key
  doubao_api_base: https://ark.cn-beijing.volces.com/api/v3
  doubao_model_name: doubao-pro-32k
  # 阿里云百炼 (通义千问)
  aliyun_api_key: your-aliyun-api-key
  aliyun_api_base: https://dashscope.aliyuncs.com/compatible-mode/v1
  aliyun_model_name: qwen-plus
  # 小米 Mimo
  mimo_api_key: your-mimo-api-key
  mimo_api_base: https://api.xiaomimimo.com/v1
  mimo_model_name: mimo-v2.6-pro

# ====================================
# 限流配置
# ====================================
rate_limit:
  enabled: true
  requests_per_minute: 60
  requests_per_hour: 1000

# ====================================
# CORS 配置
# ====================================
cors:
  enabled: true
  allow_origins:
    - "http://localhost:3000"
    - "http://localhost:8080"
  allow_credentials: true
  allow_methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allow_headers:
    - "*"
